# TripNest AI environment variables. Copy to .env for local development; NEVER commit .env.
# In production set these in the hosting provider's dashboard.

# development | production. Production refuses to start without SECRET_KEY and DATABASE_URL.
ENV=development

# PostgreSQL in production, e.g. postgresql://user:password@host:5432/tripnest
# Leave empty locally to use SQLite at backend/tripnest.db
DATABASE_URL=

# Application secret: at least 32 random characters (required in production). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_long_random_secret



# Comma-separated origins allowed to call the API from another domain (empty = same origin only)
ALLOWED_ORIGINS=

# Time zone for "now" in crowd views
APP_TZ=Asia/Kolkata


# Days of demonstration history used to train the crowd model when no saved model exists
TRAIN_DAYS=365


# Wikimedia asks API clients for a contact URL or email in the User-Agent (used for place photos)
WIKIMEDIA_CONTACT=https://github.com/your-team/tripnest-ai
# wikimedia (default) or off
PHOTO_PROVIDER=wikimedia
